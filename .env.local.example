# Sanity — copier ce fichier en .env.local et remplir les valeurs
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Token API Sanity (pour les mutations côté serveur, ne pas exposer au client)
SANITY_API_TOKEN=your-api-token


# Google Tag Manager — servi en first-party via /metrics (Google tag gateway).
# Laisser vide désactive complètement le tag et le proxy.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

